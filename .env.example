# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Prisma & Supabase PostgreSQL Connection Strings
# Ambil dari: Supabase Dashboard -> Settings -> Database -> Connection String
# 1. Transaction Pooler (Port 6543) dengan pgbouncer=true untuk DATABASE_URL di serverless/Vercel
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. Session / Direct Connection (Port 5432) untuk DIRECT_URL (migrasi Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
